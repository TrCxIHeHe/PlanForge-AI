# --- Option A: local Ollama (default) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Option B: Gemini via its OpenAI-compatible endpoint ---
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=ollama
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_API_KEY=your-local-Gemini-key
# OPENAI_MODEL=gemini-3.8-flash
# Run `python scripts/check_gemini.py` to verify account access and select an
# account-accessible generateContent model if this model is unavailable.

# --- Other OpenAI-compatible endpoints (Groq / LM Studio, etc.) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-compatible-provider-key
# OPENAI_MODEL=llama-3.3-70b-versatile

# Optional: if the primary provider is exhausted, try this one (ollama | openai)
# LLM_FALLBACK_PROVIDER=openai

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
MAX_CONCURRENCY=1
TASK_MAX_ATTEMPTS=2
MAX_REVISION_ROUNDS=1
MAX_REQUEST_CHARS=5000
OUTPUT_DIR=output/documents
INCLUDE_DOCUMENT_BASE64=true
